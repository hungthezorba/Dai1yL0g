# Supabase (required for US-003 auth)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google native sign-in (Google Cloud Console → APIs & Services → Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# Required on iOS (separate OAuth client, type iOS, bundle ID com.dai1yl0g.app)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
# Optional: auto-derived from EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID if omitted
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.1234567890-abcdef

# Google Cloud: create Web + iOS + Android OAuth clients (see Supabase React Native Google guide).
# Supabase Dashboard → Authentication → Providers → Google:
#   - Client ID: comma-separated list (Web client ID first, then iOS/Android client IDs)
#   - Client secret: from the Web client
#   - Required: enable "Skip nonce check" (fixes nonce / id_token errors on native iOS)
# Apply SQL: supabase/migrations/001_profiles.sql + 002_clips_storage.sql
# Rebuild dev client after changing native config: eas build --profile development
